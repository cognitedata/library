{
  "name": "context-quality-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3004 --strictPort",
    "dev:mock": "VITE_QUALITY_BACKEND=mock vite --port 3004 --strictPort",
    "dev:onboarding": "VITE_QUALITY_BACKEND=mock VITE_DEV_FORCE_FIRST_RUN_ONBOARDING=true vite --port 3008 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@cognite/app-sdk": "^0.11.0",
    "@cognite/aura": "^0.3.5",
    "@cognite/sdk": "^10.14.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.4",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.12"
  }
}
