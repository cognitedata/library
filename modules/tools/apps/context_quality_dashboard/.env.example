# Context Quality Dashboard: deployment configuration
#
# The dashboard READS a Context Quality backend that is deployed separately (by the Cognite library
# module). It never creates, changes or deletes backend resources. These variables only say where to read.
#
# Vite inlines them at build time, so the app that is built must be given them:
#   - local work:        copy this file to .env.local (ignored by git) and fill it in
#   - a named setup:     create .env.<name> and run `vite --mode <name>` / `vite build --mode <name>`
#   - CI or a pipeline:  set the variables in the environment of the build step
# The project, cluster URL and sign-in are NOT configured here: Fusion provides them at runtime.

# Required. "cdf" reads a deployed backend. "mock" shows built-in sample data for development and
# demos only, and always shows a "Demo mode" banner. Anything else, or nothing, is a configuration error.
VITE_QUALITY_BACKEND=cdf

# The values below are the defaults of the backend module (modules/dashboards/context_quality_v2). If you changed
# a name in the backend's config.<env>.yaml, use the same name here.

# Required when VITE_QUALITY_BACKEND=cdf: externalId of the Records stream that holds the metrics run log.
VITE_CQ_STREAM_ID=context_quality_metrics

# Required when VITE_QUALITY_BACKEND=cdf: the schema space that holds the run-log container.
VITE_CQ_SCHEMA_SPACE=sp_context_quality_metrics

# Optional: the run-log container. Defaults to ContextQualityRelationship, which the backend's data model fixes.
# Only set it if the backend was deployed with a different name.
# VITE_CQ_RELATIONSHIP_CONTAINER=ContextQualityRelationship

# Optional: the most days of history to read (whole days, 1 to 365). When unset, the dashboard reads as far
# back as the deployed stream allows, up to the 90 days of the longest trend window. The stream's own limit
# always applies on top, so this can only shorten the window.
# VITE_CQ_WINDOW_DAYS=

# Optional: the deployed metrics workflow a run is started with (both or neither). When set, the Configuration page
# offers a Run button that starts this workflow with the uploaded config file, as the signed-in user, who needs
# permission to run workflows and to do what the workflow does. Without it the dashboard only reads runs.
VITE_CQ_WORKFLOW_ID=wf_context_quality_metrics
VITE_CQ_WORKFLOW_VERSION=v1

# Optional: start the built-in checks by itself the first time the dashboard opens and there is no completed run.
# Off by default: the first-run screen shows a "Run built-in checks" button instead. Turn it on only if the backend
# function is already deployed and ready, or the first run will fail.
# VITE_CQ_AUTO_START_FIRST_RUN=true
