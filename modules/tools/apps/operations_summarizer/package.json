		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"tailwind-merge": "^3.5.0",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
