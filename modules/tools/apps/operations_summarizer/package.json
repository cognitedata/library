{
	"name": "operations-summarizer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"type-check": "tsc --noEmit",
		"deploy": "npx @cognite/cli@latest apps deploy --interactive",
		"activate": "npx @cognite/cli@latest apps activate --interactive",
		"setup-https": "npx @cognite/cli@latest apps setup-https"
	},
	"dependencies": {
		"@cognite/app-sdk": "^0.11.47681",
