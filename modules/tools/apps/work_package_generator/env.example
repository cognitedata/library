# CDF Configuration Template
APP_EXTERNAL_ID=test

# CDF Project Configuration
ORG=YOUR_ORG
PROJECT=YOUR_PROJECT
BASE_URL=YOUR_BASE_URL

# Authentication (Service Account from CDF - NOT Azure client credentials)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
SECRET_NAME=your-client-secret

# Development server port (optional)
# Defaults to 3000 for regular dev server, 1987 for Fusion dev server
# PORT=3000
# DEV_PORT=1987