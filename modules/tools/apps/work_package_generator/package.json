{
  "name": "work-package-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc ; vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:aura": "node --require ./scripts/eslint-ts6-preload.cjs ./node_modules/eslint/bin/eslint.js src",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "deploy": "npx @cognite/cli@latest apps deploy --interactive",
    "activate": "npx @cognite/cli@latest apps activate --interactive",
    "setup-https": "npx @cognite/cli@latest apps setup-https"
  },
  "dependencies": {
    "@cognite/app-sdk": "^0.11.0",
    "@cognite/aura": "^1.47284.0",
    "@cognite/sdk": "^10.14.0",
    "@preact/signals-react": "^3.10.0",
    "@tanstack/react-query": "^5.99.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "uplot": "^1.6.32",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "9.39.4",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript6": "npm:typescript@6.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.26",
    "undici": ">=8.10.0",
    "dompurify": ">=3.4.13",
    "mermaid": "~11.16.1",
    "lodash": ">=4.18.0",
    "lodash-es": ">=4.18.0",
    "@vitest/mocker": ">=5.0.5",
    "rollup": ">=4.59.0",
    "axios": ">=1.15.0",
    "minimatch": ">=9.0.7",
    "esbuild": ">=0.25.0",
    "picomatch": ">=4.0.4",
    "brace-expansion": ">=5.0.5",
    "uuid": "^11.1.1",
    "valibot": ">=1.4.2",
    "ws": ">=8.21.0",
    "js-yaml": ">=4.3.1",
    "katex": ">=0.18.2",
    "pdfjs-dist": "^6.2.108"
  }
}
