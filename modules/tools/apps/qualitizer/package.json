{
  "name": "qualitizer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "standalone": "cross-env VITE_STANDALONE=true vite",
    "standalone-internal": "cross-env VITE_STANDALONE=true VITE_SHOW_INTERNAL=true vite",
    "proxy": "node server/proxy.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deploy": "npm run build && echo 'Deploying...' && echo 'Deployed!'",
    "deploy-preview": "npm run build && echo 'Deploying preview...' && echo 'Deployed preview!'"
  },
  "dependencies": {
    "@cognite/dune": "^4.0.0",
    "@cognite/sdk": "^10.13.0",
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "clsx": "^2.1.1",
    "d3-chord": "^3.0.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "dotenv": "^17.4.2",
    "dt-sql-parser": "^4.5.0",
    "fastify": "^5.11.3",
    "lru-cache": "^11.5.2",
    "mixpanel-browser": "^2.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.26",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "flatted": "3.4.2"
  }
}
