{
  "contractVersion": "1",
  "description": "Context Quality metrics run log. Canonical machine-readable contract; see CONTRACT.md for the rules. Baseline: the run log deployed in the legacy deployment.",
  "containers": {
    "relationship": "ContextQualityRelationship",
    "fileAnnotation": "ContextQualityFileAnnotation"
  },
  "viewVersionVariable": "metricsVersion",
  "rowKinds": {
    "run": {
      "container": "relationship",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp",
        "status"
      ],
      "optional": [
        "scope",
        "warnings",
        "rowsWritten",
        "ruleSetVersion"
      ]
    },
    "aggregate": {
      "container": "relationship",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp",
        "metricId",
        "dimensionId",
        "reportingUnitId"
      ],
      "optional": [
        "facilityId",
        "divisionId",
        "disciplineId",
        "ownerId",
        "tier",
        "subKey",
        "eligibleCount",
        "passingCount",
        "issueCount",
        "valueSum",
        "notApplicable",
        "matchType",
        "ruleSetVersion"
      ]
    },
    "exclusion": {
      "container": "relationship",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp",
        "dimensionId",
        "exclusionCategory"
      ],
      "optional": [
        "reportingUnitId",
        "facilityId",
        "divisionId",
        "disciplineId",
        "excludedCount"
      ]
    },
    "drilldown": {
      "container": "relationship",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp",
        "metricId",
        "dimensionId",
        "entityId"
      ],
      "optional": [
        "reportingUnitId",
        "facilityId",
        "divisionId",
        "disciplineId",
        "ownerId",
        "tier",
        "entityLabel",
        "entityRef",
        "detail",
        "cellsJson",
        "matched"
      ]
    },
    "classification": {
      "container": "relationship",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp",
        "classificationKind",
        "classificationId"
      ],
      "optional": [
        "classificationName",
        "dimensionId",
        "reportingUnitId",
        "facilityId",
        "divisionId",
        "disciplineId",
        "ownerId",
        "tier",
        "eligibleCount",
        "passingCount",
        "issueCount"
      ]
    },
    "annotationBucket": {
      "container": "fileAnnotation",
      "required": [
        "rowKind",
        "runId",
        "runTimestamp"
      ],
      "optional": [
        "reportingUnitId",
        "facilityId",
        "divisionId",
        "disciplineId",
        "ownerId",
        "tier",
        "annotationType",
        "status",
        "confidenceBucket",
        "count",
        "confidenceSum",
        "fileExternalId",
        "fileSourceId",
        "matchedCount",
        "unmatchedCount",
        "detectedTagCount",
        "unmatchedTagsJson"
      ]
    }
  },
  "runStatuses": {
    "started": "written first",
    "complete": "written last; the only status that makes a run readable",
    "failed": "reserved, not written today"
  },
  "recordKeyPrefixes": [
    "run:started",
    "run:complete",
    "agg:",
    "excl:",
    "drill:",
    "cls:",
    "anno:"
  ],
  "tiers": [
    {
      "value": 1,
      "meaning": "Major equipment"
    },
    {
      "value": 2,
      "meaning": "Instrumentation"
    },
    {
      "value": 3,
      "meaning": "A tier a project explicitly maps asset types to; never assigned by default"
    }
  ],
